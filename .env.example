# ============================================================
# docker-compose.yml 用到的配置。
# 用法：复制一份叫 .env，然后填上真实的值：
#   cp .env.example .env
# ⚠️ .env 里是密钥，已经在 .gitignore 里，不要提交到 Git
# ============================================================

# 网站地址。有域名写域名（Caddy 会自动配置 HTTPS），比如：lingohub.example.com
# 没有域名写 :80，然后用 http://服务器公网IP 访问
SITE_ADDRESS=:80

# 数据库密码。部署时一定要换成一个长的随机密码
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Voyage AI 密钥（向量化）
EMBEDDING_API_KEY=

# Google Gemini 密钥（生成回答）
LLM_API_KEY=

# 管理员密钥：上传 PDF 时放在请求头 X-Admin-Key 里。
# 没填 → 部署后上传接口直接关闭（安全的默认值）
ADMIN_API_KEY=
